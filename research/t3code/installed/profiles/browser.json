{
  "schemaVersion": 1,
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/**/*.mts",
    "apps/**/*.cts",
    "apps/**/*.js",
    "apps/**/*.jsx",
    "apps/**/*.mjs",
    "apps/**/*.cjs",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/**/*.mts",
    "packages/**/*.cts",
    "packages/**/*.js",
    "packages/**/*.jsx",
    "packages/**/*.mjs",
    "packages/**/*.cjs",
    "infra/**/*.ts",
    "infra/**/*.tsx",
    "infra/**/*.mts",
    "infra/**/*.cts",
    "infra/**/*.js",
    "infra/**/*.jsx",
    "infra/**/*.mjs",
    "infra/**/*.cjs",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "scripts/**/*.mts",
    "scripts/**/*.cts",
    "scripts/**/*.js",
    "scripts/**/*.jsx",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs",
    "oxlint-plugin-t3code/**/*.ts",
    "oxlint-plugin-t3code/**/*.tsx",
    "oxlint-plugin-t3code/**/*.mts",
    "oxlint-plugin-t3code/**/*.cts",
    "oxlint-plugin-t3code/**/*.js",
    "oxlint-plugin-t3code/**/*.jsx",
    "oxlint-plugin-t3code/**/*.mjs",
    "oxlint-plugin-t3code/**/*.cjs",
    "vite.config.ts"
  ],
  "exclude": [
    ".repos/**"
  ],
  "packageManifests": [
    "package.json",
    "apps/*/package.json",
    "packages/*/package.json",
    "infra/*/package.json",
    "scripts/package.json",
    "oxlint-plugin-t3code/package.json",
    "apps/mobile/modules/*/package.json"
  ],
  "rules": [],
  "requireExternalResolution": true,
  "conditions": [
    "browser",
    "import",
    "default"
  ]
}
