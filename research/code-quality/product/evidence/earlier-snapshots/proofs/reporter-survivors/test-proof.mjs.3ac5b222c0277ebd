const mutated = mutation ? Buffer.concat([source.subarray(0,mutation.location.start),Buffer.from(mutation.replacement),source.subarray(mutation.location.end)]) : source;
if(mutation && source.subarray(mutation.location.start,mutation.location.end).toString()!==mutation.expected) throw new Error("Exact edit mismatch");
const directory = fs.mkdtempSync(path.join(root,"owned-test-"));
fs.mkdirSync(path.join(directory,"sdk"));fs.mkdirSync(path.join(directory,"tests"));
fs.writeFileSync(path.join(directory,"sdk/mutator-vitest-reporter.ts"),mutated);
fs.writeFileSync(path.join(directory,"sdk/mutator.ts"),protocol);
const testFile = testVariant === "original" ? path.join(sourceRoot,"tests/mutator_reporter.test.ts") : path.join(root,"mutator_reporter.proposed.test.ts");
