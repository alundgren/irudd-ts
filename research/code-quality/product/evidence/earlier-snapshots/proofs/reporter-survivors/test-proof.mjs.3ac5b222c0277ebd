import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { spawnSync } from "node:child_process";

const root = "/tmp/archguard-quality-product-reporter-survivor-review";
const sourceRoot = "/tmp/archguard-quality-product-cli-reviewed-worktree";
const recordsDirectory = "/tmp/archguard-quality-product-self-profiles-final18/state/reporter/records";
const hash = bytes => crypto.createHash("sha256").update(bytes).digest("hex");
const id = process.argv[2] ?? "baseline";
const testVariant = process.argv[3] ?? "original";
const namePattern = process.argv[4];
const source = fs.readFileSync(path.join(sourceRoot,"sdk/mutator-vitest-reporter.ts"));
const protocol = fs.readFileSync(path.join(sourceRoot,"sdk/mutator.ts"));
let mutation = null;
