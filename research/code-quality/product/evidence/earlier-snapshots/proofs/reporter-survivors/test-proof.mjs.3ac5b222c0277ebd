fs.writeFileSync(path.join(directory,"tests/mutator_reporter.test.ts"),test);
const args=["--test",...(namePattern ? [`--test-name-pattern=${namePattern}`] : []),"tests/mutator_reporter.test.ts"];
let child;
try {
  child=spawnSync(process.execPath,args,{cwd:directory,timeout:90_000,maxBuffer:1_048_576});
  const evidence={timestamp:new Date().toISOString(),node:process.version,sourceRoot,mutationId:id,mutation,variant:testVariant,namePattern:namePattern??null,reporterBeforeSha256:hash(source),reporterChildSha256:hash(mutated),protocolSha256:hash(protocol),testInputSha256:hash(test),command:[process.execPath,...args],status:child.status,signal:child.signal,error:child.error?.message??null,stdout:child.stdout.toString(),stderr:child.stderr.toString(),reporterAfterSha256:hash(fs.readFileSync(path.join(sourceRoot,"sdk/mutator-vitest-reporter.ts"))),protocolAfterSha256:hash(fs.readFileSync(path.join(sourceRoot,"sdk/mutator.ts")))};
  const resultPath=path.join(root,`test-proof-${id}-${testVariant}-${Date.now()}.json`);
  fs.writeFileSync(resultPath,JSON.stringify(evidence,null,2));
  console.log(JSON.stringify({resultPath,status:child.status,signal:child.signal,error:evidence.error,summary:evidence.stdout.split("\n").filter(line=>/^# (tests|pass|fail|duration_ms)/.test(line))}));
} finally {
  if(child && (child.status!==null || child.signal!==null)) fs.rmSync(directory,{recursive:true,force:true});
}
