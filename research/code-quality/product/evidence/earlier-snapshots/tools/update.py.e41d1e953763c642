def sha(data):
    return hashlib.sha256(data).hexdigest()


def write_json(path, data):
    path.write_text(json.dumps(data, indent=2, ensure_ascii=True) + "\n")


def retain_bytes(data, target, source, category):
    if len(data) > maximum_file or b"\0" in data:
        excluded.append({"source": source, "reason": "non-text or over 8 MiB per-file bound"})
        return
    data.decode("utf-8")
    destination = archive / target
    if destination.exists() and destination.read_bytes() != data:
        old_data = destination.read_bytes()
        historical = Path("earlier-snapshots") / target.parent / (target.name + "." + sha(old_data)[:16])
        old_destination = archive / historical
        old_destination.parent.mkdir(parents=True, exist_ok=True)
        old_destination.write_bytes(old_data)
        old_destination.chmod(0o644)
        old_metadata = metadata.get(target.as_posix(), {})
        metadata[historical.as_posix()] = {**old_metadata, "path": historical.as_posix(),
                                         "category": "earlierSnapshot", "source": source,
                                         "status": "earlier exact byte snapshot; replaced in current archive view"}
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_bytes(data)
    destination.chmod(0o644)
    old = metadata.get(target.as_posix(), {})
    metadata[target.as_posix()] = {"path": target.as_posix(), "source": source,
        "category": category, "capturedAt": old.get("capturedAt", stamp) if old.get("sha256") == sha(data) else stamp,
        "status": "exact byte snapshot; completion requires the report and provenance"}


def retain(path, target, category):
    if path.is_symlink() or not path.is_file():
        excluded.append({"source": str(path), "reason": "missing, symlink or non-regular file"})
        return
    before = path.stat()
    data = path.read_bytes()
    after = path.stat()
    if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
        raise RuntimeError("source changed during capture: " + str(path))
    retain_bytes(data, target, str(path), category)


def retain_tree(source, target, category):
    if not source.is_dir():
        excluded.append({"source": str(source), "reason": "named evidence directory unavailable"})
        return
    for directory, children, names in os.walk(source, followlinks=False):
        for child in list(children):
            candidate = Path(directory) / child
            if child in pruned or child.startswith(("owned-test-", "owned-probe-", "archguard-mutator-", "task-")) or candidate.is_symlink():
                children.remove(child)
                excluded.append({"source": str(candidate), "reason": "runtime state, dependency tree or link"})
        for name in sorted(names):
            path = Path(directory) / name
            if source.name == "new-sdk-public-control-proofs" and name == "driver.py" and Path(directory) != source:
                excluded.append({"source": str(path), "reason": "repeated SDK driver source; one root driver retained"})
                continue
            if path.suffix not in extensions and name not in {"LICENSE", "NOTICE", "COPYING", "LATEST.txt"}:
                excluded.append({"source": str(path), "reason": "executable driver or unrelated file type"})
                continue
            retain(path, target / path.relative_to(source), category)


