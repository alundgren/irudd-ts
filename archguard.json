{
  "schemaVersion": 1,
  "include": [
    "src/**/*.rs",
    "tests/**/*.rs",
    "sdk/**/*.ts",
    "examples/graph-plugin/**/*.rs",
    "examples/graph-plugin/**/*.ts",
    "examples/repository-rules/**/*.rs",
    "examples/repository-rules/**/*.ts",
    "examples/semantic/**/*.rs",
    "examples/semantic/**/*.ts",
    "providers/typescript7/provider.mjs"
  ],
  "rules": [
    {
      "id": "facts-independent",
      "kind": "forbiddenImport",
      "files": [
        "src/facts.rs",
        "src/semantic/facts.rs"
      ],
      "specifiers": [
        "crate::config",
        "crate::config::*",
        "crate::project",
        "crate::project::*",
        "crate::rules",
        "crate::rules::*",
        "crate::plugin",
        "crate::plugin::*",
        "crate::cache",
        "crate::cache::*",
        "crate::semantic",
        "crate::semantic::*",
        "crate::subprocess",
        "crate::subprocess::*",
        "crate::roles",
        "crate::roles::*",
        "crate::semantic::*"
      ]
    },
    {
      "id": "providers-no-policy",
      "kind": "forbiddenImport",
      "files": [
        "src/typescript.rs",
        "src/rust.rs"
      ],
      "specifiers": [
        "crate::rules",
        "crate::rules::*",
        "crate::plugin",
        "crate::plugin::*",
        "crate::project",
        "crate::project::*",
        "crate::config",
        "crate::config::*",
        "crate::cache",
        "crate::cache::*",
        "crate::semantic",
        "crate::semantic::*",
        "crate::subprocess",
        "crate::subprocess::*"
      ]
    },
    {
      "id": "sdk-no-host-internals",
      "kind": "forbiddenDependency",
      "files": [
        "sdk/**"
      ],
      "targets": [
        "examples/**",
        "providers/**",
        "research/**"
      ],
      "transitive": true
    },
    {
      "id": "sdk-api",
      "kind": "requiredExport",
      "files": [
        "sdk/index.ts"
      ],
      "names": [
        "ProjectFacts",
        "Diagnostic",
        "runPlugin",
        "dependencyPaths",
        "createDependencyQuery",
        "SemanticFacts",
        "SemanticRule",
        "readSemanticFacts",
        "semanticFile",
        "missingMemberDiagnostics",
        "readMutationRequest",
        "validateMutationRequest",
        "validateMutationResult",
        "writeMutationResult",
        "TestExecutionRequest",
        "TestExecutionResult",
        "TestCounts",
        "TestFailure",
        "TestFailureKind",
        "MutationVitestReporter",
        "mutationProtocolLimits"
      ]
    },
    {
      "id": "syntax-independent",
      "kind": "forbiddenImport",
      "files": [
        "src/typescript.rs",
        "src/rust.rs"
      ],
      "specifiers": [
        "crate::roles",
        "crate::roles::*"
      ]
    },
    {
      "id": "semantic-inventory-no-policy",
      "kind": "forbiddenImport",
      "files": [
        "src/semantic/inventory.rs"
      ],
      "specifiers": [
        "crate::rules",
        "crate::rules::*",
        "crate::roles",
        "crate::roles::*",
        "crate::plugin",
        "crate::plugin::*",
        "crate::project",
        "crate::project::*",
        "crate::cache",
        "crate::cache::*",
        "crate::subprocess",
        "crate::subprocess::*",
        "crate::semantic::check",
        "crate::semantic::SemanticRule",
        "crate::semantic::rules",
        "crate::semantic::rules::*"
      ]
    },
    {
      "id": "semantic-validation-no-policy",
      "kind": "forbiddenImport",
      "files": [
        "src/semantic/validation.rs"
      ],
      "specifiers": [
        "crate::rules",
        "crate::rules::*",
        "crate::roles",
        "crate::roles::*",
        "crate::plugin",
        "crate::plugin::*",
        "crate::project",
        "crate::project::*",
        "crate::cache",
        "crate::cache::*",
        "crate::subprocess",
        "crate::subprocess::*",
        "crate::semantic::check",
        "crate::semantic::SemanticRule",
        "crate::semantic::rules",
        "crate::semantic::rules::*"
      ]
    },
    {
      "id": "product-no-research-imports",
      "kind": "forbiddenImport",
      "files": [
        "sdk/**",
        "providers/**",
        "examples/graph-plugin/**",
        "examples/repository-rules/**",
        "examples/semantic/**"
      ],
      "specifiers": [
        "research/**",
        "**/research/**"
      ]
    }
  ],
  "repository": {
    "roles": [
      {
        "id": "rust-module",
        "files": [
          "src/**/*.rs"
        ],
        "exclude": [
          "src/roles.rs",
          "src/cache.rs",
          "src/semantic/**"
        ]
      },
      {
        "id": "repository-policy",
        "files": [
          "src/roles.rs"
        ]
      },
      {
        "id": "graph-cache",
        "files": [
          "src/cache.rs"
        ]
      },
      {
        "id": "compiler-semantics",
        "files": [
          "src/semantic/**"
        ],
        "exclude": [
          "src/semantic/mod.rs"
        ]
      },
      {
        "id": "test",
        "files": [
          "tests/**/*.rs"
        ]
      },
      {
        "id": "typescript-sdk",
        "files": [
          "sdk/**/*.ts"
        ]
      },
      {
        "id": "example",
        "files": [
          "examples/**/*.ts",
          "examples/**/*.rs"
        ]
      },
      {
        "id": "semantic-provider",
        "files": [
          "providers/typescript7/provider.mjs"
        ]
      },
      {
        "id": "semantic-coordinator",
        "files": [
          "src/semantic/mod.rs"
        ]
      }
    ],
    "rules": [
      {
        "id": "own-source-role",
        "kind": "classified",
        "files": [
          "src/**/*.rs",
          "tests/**/*.rs",
          "sdk/**/*.ts",
          "examples/graph-plugin/**/*.rs",
          "examples/graph-plugin/**/*.ts",
          "examples/repository-rules/**/*.rs",
          "examples/repository-rules/**/*.ts",
          "examples/semantic/**/*.rs",
          "examples/semantic/**/*.ts",
          "providers/typescript7/provider.mjs"
        ]
      },
      {
        "id": "repository-policy-test",
        "kind": "companion",
        "role": "repository-policy",
        "replace": [
          "src/",
          "tests/"
        ]
      },
      {
        "id": "graph-cache-test",
        "kind": "companion",
        "role": "graph-cache",
        "replace": [
          "src/",
          "tests/"
        ]
      },
      {
        "id": "compiler-semantics-test",
        "kind": "companion",
        "role": "semantic-coordinator",
        "replace": [
          "src/semantic/mod.rs",
          "tests/semantic.rs"
        ]
      }
    ]
  }
}
