{
  "schemaVersion": 1,
  "plan": {
    "schemaVersion": 1,
    "selection": {
      "include": [
        "examples/code-quality/domain.ts"
      ]
    }
  },
  "execution": {
    "command": [
      "node",
      "examples/code-quality/run-domain.ts",
      "weak"
