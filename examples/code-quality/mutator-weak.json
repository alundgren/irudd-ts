      "exclude": [
        ".git/**",
        "**/node_modules/**",
        "node_modules/**",
        "target/**"
      ]
    },
    "limits": {
      "workers": 1,
      "maxMutants": 100,
      "commandTimeoutMs": 10000,
      "runTimeoutMs": 120000
    }
  }
}
